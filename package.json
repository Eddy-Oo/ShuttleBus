{
  "name": "shuttletrack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "npm run --workspace @shuttletrack/backend dev",
    "build": "vite build",
    "build:api": "npm run --workspace @shuttletrack/backend prisma:generate && npm run --workspace @shuttletrack/backend build",
    "start:api": "npm run --workspace @shuttletrack/backend start",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run src/__tests__ backend/src",
    "test:watch": "vitest src/__tests__ backend/src",
    "test:api": "npm run --workspace @shuttletrack/backend test",
    "test:simulator": "node --test simulator/lib.test.mjs",
    "test:live": "npm run build:api && npm run --workspace @shuttletrack/backend test:live",
    "simulate": "node --env-file-if-exists=simulator/.env simulator/index.mjs",
    "build:render": "node scripts/check-render-env.mjs && npm run build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "npm run --workspace @shuttletrack/backend prisma:generate",
    "db:migrate": "npm run --workspace @shuttletrack/backend prisma:migrate:dev",
    "db:deploy": "npm run --workspace @shuttletrack/backend prisma:migrate:deploy",
    "db:seed": "npm run --workspace @shuttletrack/backend seed"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.18",
    "@types/leaflet": "^1.9.22",
    "@types/uuid": "^10.0.0",
    "cannon-es": "^0.20.0",
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.8",
    "gsap": "^3.13.0",
    "i18next": "^23.10.1",
    "i18next-browser-languagedetector": "^7.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.533.0",
    "matter-js": "^0.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.0",
    "react-router-dom": "^6.30.1",
    "react-use": "^17.6.0",
    "socket.io-client": "^4.8.3",
    "three": "^0.179.1",
    "uuid": "^14.0.2",
    "zod": "^3.25.67",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.0",
    "@types/node": "^24.0.14",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "socket.io": "4.8.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  },
  "workspaces": [
    "backend"
  ]
}
