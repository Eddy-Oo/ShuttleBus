{
  "name": "@shuttletrack/backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run src",
    "test:live": "node --env-file-if-exists=tests/.env --test tests/integration.test.mjs",
    "seed:admin": "tsx prisma/seed.ts --admin-only"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "3.0.2",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "express-rate-limit": "8.1.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "socket.io": "4.8.3",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.0.14",
    "prisma": "6.19.0",
    "tsx": "4.20.6",
    "typescript": "5.8.3",
    "vitest": "5.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
