# API origin only; use HTTPS for Render. Never use a VITE_ prefix for secrets.
SIM_API_URL=http://localhost:3000
SIM_VEHICLE_ID=v-1

# Option A (recommended): Admin > Vehicles > key icon, paste the one-time token here.
SIM_DEVICE_TOKEN=

# Option B (dev/demo only): leave SIM_DEVICE_TOKEN empty and give admin credentials;
# the simulator rotates the vehicle's device token on every run (revokes old tokens).
SIM_ADMIN_USERNAME=
SIM_ADMIN_PASSWORD=

# Optional; otherwise uses vehicle.assignedRouteId. Must match an assigned route.
SIM_ROUTE_ID=
# Number of passes over the route; 0 = keep looping until Ctrl+C.
SIM_LOOPS=1
SIM_INTERVAL_MS=1000
SIM_STEPS_PER_SEGMENT=20
